{
  "schema_version": 1,
  "id": "stage6e_battle_commands",
  "extends": "stage5e_mega_runtime.json",
  "build_target": "stage6e-battle-ui-proof",
  "truncate_steps": 25,
  "append_steps": [
    {"action": "write_memory", "symbol": "gStage5ERuntimeState", "offset": 4, "width": 4, "value": 2},
    {"action": "wait_memory", "symbol": "gStage5ERuntimeState", "offset": 8, "width": 4, "value": 2, "timeout_frames": 600},
    {"assert": "memory_value", "symbol": "gStage5ERuntimeState", "offset": 108, "width": 4, "value": 334},
    {"assert": "memory_value", "symbol": "gStage5ERuntimeState", "offset": 116, "width": 4, "value": 334},
    {"assert": "memory_nonzero", "symbol": "gStage5ERuntimeState", "offset": 120, "width": 4},
    {"action": "move", "direction": "east", "tiles": 1},
    {"action": "capture", "name": "altaria_before_mega_battle"},
    {"action": "move", "target": {"x": 31, "z": 16}},
    {"assert": "native_transition", "direction": "east", "from_map_id": 540, "to_map_id": 541, "no_warp": true},
    {"action": "move", "direction": "east", "tiles": 7},
    {"action": "hold", "button": "right", "frames": 180},
    {"action": "release", "button": "right", "after_frames": 120},
    {"action": "wait", "frames": 1200},
    {"action": "press", "button": "a", "after_frames": 240},
    {"action": "press", "button": "a", "after_frames": 240},
    {"action": "wait_memory", "symbol": "gStage5ERuntimeState", "offset": 132, "width": 4, "value": 1, "timeout_frames": 2400},
    {"assert": "memory_value", "symbol": "gStage5ERuntimeState", "offset": 136, "width": 4, "value": 1},
    {"assert": "memory_value", "symbol": "gStage5ERuntimeState", "offset": 140, "width": 4, "value": 334},
    {"assert": "memory_value", "symbol": "gStage5ERuntimeState", "offset": 144, "width": 4, "value": 0},
    {"assert": "memory_value", "symbol": "gStage5ERuntimeState", "offset": 148, "width": 4, "value": 334},
    {"assert": "memory_value", "symbol": "gStage5ERuntimeState", "offset": 152, "width": 4, "value": 755},
    {"action": "capture", "name": "mega_altaria_fight_menu"},
    {"action": "touch", "x": 128, "y": 170, "after_frames": 360},
    {"action": "capture", "name": "stage6e_battle_main_commands"},
    {"assert": "screenshot_valid", "name": "stage6e_battle_main_commands"},

    {"action": "touch", "x": 40, "y": 170, "after_frames": 600},
    {"action": "capture", "name": "stage6e_battle_bag"},
    {"assert": "screenshot_valid", "name": "stage6e_battle_bag"},
    {"action": "press", "button": "b", "after_frames": 600},
    {"action": "press", "button": "b", "after_frames": 600},

    {"action": "touch", "x": 220, "y": 170, "after_frames": 600},
    {"action": "capture", "name": "stage6e_battle_switch"},
    {"assert": "screenshot_valid", "name": "stage6e_battle_switch"},
    {"action": "touch", "x": 190, "y": 30, "after_frames": 240},
    {"action": "press", "button": "a", "after_frames": 600},
    {"action": "press", "button": "a", "after_frames": 600},
    {"action": "wait", "frames": 1600},
    {"action": "capture", "name": "stage6e_battle_switched"},
    {"assert": "screenshot_valid", "name": "stage6e_battle_switched"},

    {"action": "touch", "x": 128, "y": 170, "after_frames": 600},
    {"action": "capture", "name": "stage6e_battle_run_denied"},
    {"assert": "screenshot_valid", "name": "stage6e_battle_run_denied"},
    {"action": "press", "button": "a", "after_frames": 600},
    {"assert": "rom_running", "value": true}
  ]
}
