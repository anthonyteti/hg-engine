    {"action": "press", "button": "left", "held_frames": 8, "after_frames": 30},
    {"action": "press", "button": "a", "held_frames": 12, "after_frames": 300},
    {"assert": "map_id", "value": 68},
    {"action": "move", "direction": "north", "tiles": 3},
    {"action": "press", "button": "left", "held_frames": 8, "after_frames": 30},
    {"action": "press", "button": "a", "after_frames": 300},
    {"action": "capture", "name": "stage6g_dialogue"},
    {"action": "press", "button": "a", "after_frames": 240},
    {"action": "capture", "name": "stage6g_shop"},
    {"assert": "screenshot_valid", "name": "stage6g_dialogue"},
